
# =====================================
# FairSky - Git Ignore
# =====================================

# Build outputs
**/bin/
**/obj/
**/AppPackages/
**/publish/
**/TestResults/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code - local settings
.vscode/

# Certificates and private keys
*.pfx
*.p12
*.p8
*.pem
*.key
*.cer
*.crt

# Local development certificate
FairSky-dev.pfx

# Local logs and temporary files
*.log
*.tmp
*.bak
*.cache

# OS-generated files
Thumbs.db
Desktop.ini
.DS_Store
